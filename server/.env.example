# ---- copy this file to ".env" (local) or enter the same names in your host's "Environment" page (Render/Railway) ----

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=bearcat
DB_PASSWORD=change-me
DB_NAME=bearcat_travels
# Set to true if your host requires an encrypted connection (Aiven, PlanetScale-style, Azure, etc.)
DB_SSL=false

# Long random text used to sign login tokens. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Where your front-end lives (CORS). Comma separated, NO trailing slash, scheme + host only.
# GitHub Pages example: https://your-username.github.io
CORS_ORIGIN=http://localhost:8000,http://127.0.0.1:8000

# First owner account created by "npm run seed"
OWNER_NAME=Owner
OWNER_EMAIL=owner@bearcat.com
OWNER_PASSWORD=ChangeThisPassword1

# Hours ahead of UTC for the business (Philippines = 8). Used for booking reference dates.
BUSINESS_TZ_OFFSET_HOURS=8

# The password-reset page needs a way to deliver the link. No email sender is wired in, so with "true" the
# reset token is returned to the browser (fine for a school demo). Set to "false" for real use and add an emailer.
SHOW_RESET_LINK=true

PORT=3000
